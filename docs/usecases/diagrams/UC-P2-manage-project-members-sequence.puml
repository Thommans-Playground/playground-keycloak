@startuml UC-P2-manage-project-members-sequence
!include ../../domain/diagrams/_style.puml
hide footbox
title UC-P2 Manage project members (detailed sequence, planned)
' Step ids are the main flow numbers of UC-P2. Not built yet.
' An administrator may only add a manager to a project with no active manager, and never themselves.

actor "Caller" as U
participant "API" as A #E6F0FB
participant "Projects" as P #E7F4EA
participant "Account\n(Access)" as C #E7F4EA

U -> A : 2 add, change or remove
A -> P : 4 caller's role in this project
alt caller is not a manager here
  alt administrator adds a manager, none is active,\nperson is not the caller
    A -> C : 5 active account?
    A -> P : 7 add the manager + 8 audit
    A --> U : updated member list
  else anything else
    A --> U : refused
  end
else
  A -> C : 5 active account? (add only)
  A -> P : 6 would a manager remain?
  alt not active, or last manager lost
    A --> U : refused
  else
    A -> P : 7 apply + 8 audit entry
    A --> U : updated member list
  end
end
@enduml
