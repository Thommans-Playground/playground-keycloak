@startuml UC-A7-sign-in-through-company-single-sign-on-analysis-sequence
!include ../../domain/diagrams/_style.puml
hide footbox
title UC-A7 Sign in through company SSO (analysis: system sequence)
' Analysis level (decision 9): the person, Playground as one box, Keycloak and the company login as outside systems.
' No route, store, port, adapter, token or cookie. Step numbers are the main flow numbers of UC-A7.
' Steps 1 and 5 are UC-A1. Not decided yet, so not drawn: the email that already belongs to another Keycloak user
' (open in UC-A7).

actor "Person" as P
participant "Playground" as PG #E6F0FB
participant "Keycloak\n(outside system)" as K #ECECEC
participant "Company\nlogin" as C #ECECEC

P -> PG : 1 sign in\n(as UC-A1)
PG --> P : 1 go to\nKeycloak
P -> K : 2 choose the\ncompany login
K --> P : 3 go to the\ncompany login
P -> C : 3 sign in there
alt refuses
  C --> K : refused
  K --> P : error
else
  C --> K : 4 proof
  K -> K : 4 create or find\nthe user
  K --> P : 5 back, with proof
  P -> PG : 5 proof\n(as UC-A1)
  PG --> P : 5 signed in
  P -> PG : 6 first request
  PG -> PG : 6 pending account\nif none (UC-A3)
  PG --> P : the answer
end
@enduml
