@startuml UC-P2-manage-project-members-design-sequence
!include ../../domain/diagrams/_style.puml
hide footbox
title UC-P2 Manage project members (design sequence, planned)
' Design level (decision 9). The analysis level is UC-P2-manage-project-members-analysis-sequence.puml.
' Alpha scope (decision 13): administrator changes members, no project roles.
' Step ids are the main flow numbers of UC-P2. Not built yet.

actor "Caller" as U
participant "API" as A #E6F0FB
participant "Projects" as P #E7F4EA
participant "Access" as C #E7F4EA

U -> A : 2 add or remove
A -> P : 4 member?\nrole?
alt neither a member nor an administrator
  A --> U : 4 same answer as\na missing project
else a member, not an administrator
  A --> U : 4 refused
else an administrator
  A -> C : 5 active account?\n(add only)
  alt not active, or not a member (remove)
    A --> U : refused
  else
    A -> P : 6 apply\n7 audit entry
    A --> U : updated member list
  end
end
@enduml
