@startuml UC-A4-approve-deactivate-and-reinstate-an-account-design-sequence
!include ../../domain/diagrams/_style.puml
hide footbox
skinparam maxMessageSize 110
title UC-A4 Approve, deactivate, reinstate, promote and demote (design sequence)
' Design level (decision 9), drawn against docs/domain/diagrams/access-design.puml. Analysis: UC-A4-approve-deactivate-and-reinstate-an-account-analysis-sequence.puml.
' Step numbers are the main flow numbers of UC-A4. BUILT: all of it, except the order of a deactivation.
' PLANNED (decision 10): a deactivation changes our account first, then Keycloak. The code today calls Keycloak first.
' Not drawn: the web page and its reason dialog (D12) and the token check, which is UC-A1 step 9.

actor "Administrator" as AD
participant "Routes\n(API)" as R #E6F0FB
participant "AccessService" as S #E7F4EA
participant "Domain\ndecide()" as DM #FFE6CC
participant "Account-\nRepository" as AR #EEE7F7
participant "IdentityProvider\n(Keycloak admin)" as IDP #EEE7F7
participant "AuditLog" as AL #EEE7F7

AD -> R : 1, 2 POST /accounts/{id}/{action}, with the reason
R -> R : 4 guard: token, not deactivated, not pending, administrator
alt not an administrator
  R --> AD : 4 403 forbidden
else
  R -> S : change(actor, id, action, reason)
  S -> AR : 1 by_id(id)
  S -> DM : 3 clean_reason(reason)
  alt no reason that says something
    DM --> R : ReasonRequired
    R --> AD : 422
  end
  S -> AR : count_active_administrators()
  S -> DM : 5 decide(action, actor, target, active_admins)
  alt self change, last administrator, or wrong state
    DM --> R : CannotChangeSelf, LastAdministrator or InvalidTransition
    R --> AD : refused (409, or the self change status)
  else approve, promote or demote
    DM --> S : account with the new status or role
    note right of S : Keycloak is not called
  else deactivate or reinstate
    S -> IDP : 5 disable_user + end_sessions, or enable_user
    alt Keycloak fails
      IDP --> S : error
      S --> R : IdentityProviderUnavailable
      R --> AD : 6 error, retry
    end
  end
  S -> AR : 5 save(account)
  S -> AL : 7 record(actor, action, target, reason)
  S --> R : account
  R --> AD : 8 200 the account
end
@enduml
