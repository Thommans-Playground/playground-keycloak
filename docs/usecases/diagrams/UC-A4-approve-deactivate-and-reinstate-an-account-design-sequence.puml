@startuml UC-A4-approve-deactivate-and-reinstate-an-account-design-sequence
!include ../../domain/diagrams/_style.puml
hide footbox
skinparam maxMessageSize 110
title UC-A4 Approve, deactivate, reinstate, promote and demote (design sequence)
' Design level (decision 9), drawn against docs/domain/diagrams/access-design.puml. Analysis: UC-A4-approve-deactivate-and-reinstate-an-account-analysis-sequence.puml.
' Step numbers are the main flow numbers of UC-A4. BUILT (ADR 0009, decisions 14 and 18): the lock on the active administrators and the re-read of
' the actor and target, a deactivation committed with its audit entry before Keycloak is called, the outcome instead of an error, the repeat of a
' deactivation. NOT BUILT: the audit entry going to the Audit context (BC-AUDIT), still the Access table (D14).
' Not drawn: the web page and its reason dialog (D12) and the token check, which is UC-A1 step 9.

actor "Administrator" as AD
participant "Routes\n(API)" as R #E6F0FB
participant "AccessService" as S #E7F4EA
participant "Domain\ndecide()" as DM #FFE6CC
participant "Accounts" as AR #EEE7F7
participant "Unit-\nOfWork" as UW #EEE7F7
participant "Identity-\nProvider" as IDP #EEE7F7
participant "AuditLog" as AL #EEE7F7

AD -> R : 1, 2 POST /accounts/{id}/{action}, with the reason
R -> R : 4 guard: token, not deactivated, not pending, administrator
alt not an administrator
  R --> AD : 4 403 forbidden
else
  R -> S : change(actor, id, action, reason)
  S -> AR : 5 lock_active_administrators()
  S -> AR : 5 by_id(actor), by_id(target)
  S -> DM : 3 clean_reason(reason), not for an approval
  S -> DM : 5 decide(action, actor, target, locked administrators)
  alt no reason, self change, last administrator or wrong state
    DM --> R : ReasonRequired, CannotChangeSelf, LastAdministrator, InvalidTransition
    R --> AD : 422, 409 or the self change status
  else approve, promote or demote (no Keycloak call)
    S -> AR : 6 save(account)
    S -> AL : 8 record(actor, action, target, reason)
  else deactivate, or again (AC-77)
    S -> AR : 6 save(deactivated), none if again
    S -> AL : 8 record(..., outcome done)
    S -> UW : 6 commit() (the lock is released)
    S -> IDP : 6 disable_user + end_sessions
    alt Keycloak fails
      S -> AL : 7 set_outcome(keycloak_not_updated)
      S --> R : ChangeResult(keycloak_updated false)
      R --> AD : 7 200 "Keycloak was not updated", repeat
    end
  else reinstate
    S -> IDP : 6 enable_user (first)
    alt Keycloak fails
      S --> R : IdentityProviderUnavailable (nothing changed)
      R --> AD : 7 502 Keycloak unreachable, still deactivated
    else
      S -> AR : 6 save(active)
      S -> AL : 8 record(actor, action, target, reason)
    end
  end
  S --> R : ChangeResult
  R --> AD : 9 200 the account (with keycloak_updated for a deactivation)
end
@enduml
