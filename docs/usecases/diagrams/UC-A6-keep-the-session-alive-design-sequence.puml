@startuml UC-A6-keep-the-session-alive-design-sequence
!include ../../domain/diagrams/_style.puml
hide footbox
title UC-A6 Keep the session alive (design sequence, built)
' Design level (decision 9). The analysis level is UC-A6-keep-the-session-alive-analysis-sequence.puml.
' Step ids are the main flow numbers of UC-A6.
' Evolved from MK3 UC-A3: no refresh endpoint or whitelist. One refresh at a time for each session.

actor "Person" as P
participant "Web server\naccessToken()" as W #E6F0FB
participant "Session store\n(memory or Redis)" as S #EEE7F7
participant "Keycloak" as K #ECECEC
participant "API" as A #E6F0FB

P -> W : 1 request
W -> S : 1 find session
W -> W : 2 access token ends in < 30 s?
alt still good
  W -> A : request + access token
else about to expire
  W -> W : 3 refresh already running? (a map in this process)
  alt yes
    W -> W : wait for that refresh
  else no
    W -> K : 4 refresh token grant
    alt Keycloak refuses (ended, disabled, token reused)
      K --> W : error
      W -> S : drop session
      W --> P : sign in again
    else
      K --> W : 5 new access token (+ new refresh token)
      W -> S : 6 store in the session
    end
  end
  W -> A : 6 request + new access token
end
A --> W : answer
@enduml
