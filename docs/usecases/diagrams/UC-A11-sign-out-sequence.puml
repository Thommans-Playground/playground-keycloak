@startuml UC-A11-sign-out-sequence
!include ../../domain/diagrams/_style.puml
hide footbox
title UC-A11 Sign out (detailed sequence, built)
' Step ids are the main flow numbers of UC-A11.
' Evolved from MK3 UC-A2: no refresh token to revoke, but two sessions to end.

actor "Person" as P
participant "Web route\n/auth/logout" as W #E6F0FB
participant "Session store\n(server memory)" as S #EEE7F7
participant "Keycloak" as K #ECECEC

P -> W : 1 POST sign out\n(GET does nothing)
W -> S : 2 find session by cookie
S --> W : session (ID token)
W -> S : 2 drop session and tokens
alt Keycloak address not available
  W --> P : 5 delete cookie, go to home page
else
  W --> P : 3 303 to Keycloak end-session,\n5 delete cookie
  P -> K : 3 end-session + ID token hint
  K -> K : 4 end the Keycloak session
  K --> P : 4 redirect to home page
end
P -> W : 6 next request: no session,\nasked to sign in
@enduml
