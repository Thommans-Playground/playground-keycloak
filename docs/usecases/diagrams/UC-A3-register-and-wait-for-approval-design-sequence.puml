@startuml UC-A3-register-and-wait-for-approval-design-sequence
!include ../../domain/diagrams/_style.puml
hide footbox
title UC-A3 Register and wait for approval (design sequence, built)
' Design level (decision 9): the routes, use cases, ports and adapters that do the work. The analysis level is UC-A3-register-and-wait-for-approval-analysis-sequence.puml.
' Step ids are the main flow numbers of UC-A3.
' Evolved from MK3 UC-A5: registration is Keycloak's. The account is made on the first request.

actor "Person" as P
participant "Web server" as W #E6F0FB
participant "Keycloak" as K #ECECEC
participant "API" as A #E6F0FB
participant "AccessService" as S #E7F4EA
database "API database" as D #ECECEC

== Register at Keycloak ==
P -> W : 1 create an account
W --> P : 1 redirect, prompt=create
P -> K : 2 name, email, password
K -> K : 2 create the user
K --> P : 2 signed in, back with code
P -> W : 3 callback, session made (UC-A1)

== First request ==
P -> W : 4 first request
W -> A : 4 request + access token
A -> S : 5 account_for(identity, name, email, verified)
S -> D : 5 find by identity
alt account found
  D --> S : account
  S -> S : refresh name and email
else none found
  S -> S : 6 role = user, status = pending
  note right of S : first administrator only if the email\nis in BOOTSTRAP_ADMIN_EMAILS\nand Keycloak says it is verified
  S -> D : 6 add account, 7 audit entry "register"
end
S --> A : account
alt pending and not /me
  A --> W : 8 403 waiting for approval
else /me
  A --> W : 9 status pending
  W --> P : 9 "Waiting for approval"
end
@enduml
