' =====================================================================
'  _style.puml: shared styling for all Playground diagrams.
'  The simple style of MK3: plain boxes, a few skinparams, and colours set on each box.
'  Included by every diagram so the set stays consistent.
'  This file has NO @startuml / @enduml: it is meant to be !included.
' =====================================================================
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam wrapWidth 220

skinparam class {
  BorderColor #555555
  FontColor #1A1A1A
  BackgroundColor #FFFFFF
}
skinparam package {
  BorderColor #888888
  FontColor #1A1A1A
}
skinparam note {
  BackgroundColor #FFFDF5
  BorderColor #C9C28F
}
