vb:Criterion a owl:Class ; rdfs:label "Criterion" ; rdfs:comment "A testable acceptance criterion of a use case." .
vb:Task a owl:Class ; rdfs:label "Task" ; rdfs:comment "A commit-sized piece of a use case that ends with a passing test." .
vb:Step a owl:Class ; rdfs:label "Step" ; rdfs:comment "One numbered message of a use case's sequence diagram." .
vb:Test a owl:Class ; rdfs:label "Test" ; rdfs:comment "A test that proves criteria." .
vb:CodeFile a owl:Class ; rdfs:label "CodeFile" ; rdfs:comment "A production file that realises a use case or a step." .
vb:TestFile a owl:Class ; rdfs:label "TestFile" ; rdfs:comment "A test file that verifies a use case or a step." .
vb:BoundedContext a owl:Class ; rdfs:label "BoundedContext" ; rdfs:comment "A part of the system with its own model and vocabulary." .
vb:Term a owl:Class ; rdfs:label "Term" ; rdfs:comment "A word of the project's ubiquitous language." .

vb:concernsProblem a owl:ObjectProperty ; rdfs:domain vb:Request ; rdfs:range vb:Problem ; rdfs:comment "The problem a request is about." .
