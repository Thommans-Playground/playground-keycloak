vb:realisesRequirement a owl:ObjectProperty ; rdfs:domain vb:UseCase ; rdfs:range vb:Requirement ; rdfs:comment "A requirement a use case realises." .
vb:dependsOn a owl:ObjectProperty ; rdfs:domain vb:UseCase ; rdfs:range vb:UseCase ; rdfs:comment "A use case that must be built first." .
vb:criterionOf a owl:ObjectProperty ; rdfs:domain vb:Criterion ; rdfs:range vb:UseCase ; rdfs:comment "The use case a criterion belongs to." .
vb:satisfiesRequirement a owl:ObjectProperty ; rdfs:domain vb:Criterion ; rdfs:range vb:Requirement ; rdfs:comment "A requirement a criterion makes testable." .
vb:verifiesCriterion a owl:ObjectProperty ; rdfs:domain vb:Test ; rdfs:range vb:Criterion ; rdfs:comment "A criterion a test proves." .
vb:taskOf a owl:ObjectProperty ; rdfs:domain vb:Task ; rdfs:range vb:UseCase ; rdfs:comment "The use case a task belongs to." .
vb:closesCriterion a owl:ObjectProperty ; rdfs:domain vb:Task ; rdfs:range vb:Criterion ; rdfs:comment "A criterion a task closes." .
vb:buildsStep a owl:ObjectProperty ; rdfs:domain vb:Task ; rdfs:range vb:Step ; rdfs:comment "A sequence step a task builds." .
vb:stepOf a owl:ObjectProperty ; rdfs:domain vb:Step ; rdfs:range vb:UseCase ; rdfs:comment "The use case whose sequence diagram holds a step." .
vb:stepRealisedIn a owl:ObjectProperty ; rdfs:domain vb:Step ; rdfs:range vb:CodeFile ; rdfs:comment "Code that carries `Realises UC-… · STP-…` for the step." .
vb:stepDrivenBy a owl:ObjectProperty ; rdfs:domain vb:Step ; rdfs:range vb:TestFile ; rdfs:comment "A test file with a real test that says it drives the step." .
vb:realisedIn a owl:ObjectProperty ; rdfs:domain vb:UseCase ; rdfs:range vb:CodeFile ; rdfs:comment "Code tagged `Realises` for the use case." .
vb:verifiedBy a owl:ObjectProperty ; rdfs:domain vb:UseCase ; rdfs:range vb:TestFile ; rdfs:comment "A test file tagged `Verifies` for the use case." .
vb:inContext a owl:ObjectProperty ; rdfs:domain vb:UseCase ; rdfs:range vb:BoundedContext ; rdfs:comment "The bounded context a use case lives in." .
vb:termInContext a owl:ObjectProperty ; rdfs:domain vb:Term ; rdfs:range vb:BoundedContext ; rdfs:comment "The bounded context a term belongs to." .
vb:notToBeConfusedWith a owl:ObjectProperty, owl:SymmetricProperty ; rdfs:domain vb:Term ; rdfs:range vb:Term ; rdfs:comment "A defined term this one is not." .
vb:planned a owl:DatatypeProperty ; rdfs:range xsd:boolean ; rdfs:comment "True when the step is marked (planned) in the diagram: not built yet." .
