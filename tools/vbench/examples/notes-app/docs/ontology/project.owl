  <rdf:Description rdf:about="urn:vbench:project:tests%2Ftest_create_note.py%3A%3Atest_a_saved_note_has_an_id_and_both_timestamps"><rdf:type rdf:resource="urn:vbench:method:Test"/><rdfs:label>A saved note has an id and both timestamps</rdfs:label><vb:verifiesCriterion rdf:resource="urn:vbench:project:AC-N-001"/></rdf:Description>
  <rdf:Description rdf:about="urn:vbench:project:tests%2Ftest_create_note.py%3A%3Atest_an_empty_or_blank_body_is_refused_and_nothing_is_stored"><rdf:type rdf:resource="urn:vbench:method:Test"/><rdfs:label>An empty or blank body is refused and nothing is stored</rdfs:label><vb:verifiesCriterion rdf:resource="urn:vbench:project:AC-N-002"/></rdf:Description>
