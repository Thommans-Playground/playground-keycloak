  <rdf:Description rdf:about="urn:vbench:project:STP-N-003"><rdf:type rdf:resource="urn:vbench:method:Step"/><rdfs:label>refused, reason names the body</rdfs:label><vb:stepDrivenBy rdf:resource="urn:vbench:project:file-tests-test-create-note-py"/><vb:stepOf rdf:resource="urn:vbench:project:UC-N-001"/><vb:stepRealisedIn rdf:resource="urn:vbench:project:file-src-notes-note-py"/><vb:planned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</vb:planned></rdf:Description>
  <rdf:Description rdf:about="urn:vbench:project:STP-N-004"><rdf:type rdf:resource="urn:vbench:method:Step"/><rdfs:label>add(note)</rdfs:label><vb:stepDrivenBy rdf:resource="urn:vbench:project:file-tests-test-create-note-py"/><vb:stepOf rdf:resource="urn:vbench:project:UC-N-001"/><vb:stepRealisedIn rdf:resource="urn:vbench:project:file-src-notes-create-py"/><vb:planned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</vb:planned></rdf:Description>
  <rdf:Description rdf:about="urn:vbench:project:STP-N-005"><rdf:type rdf:resource="urn:vbench:method:Step"/><rdfs:label>the stored note</rdfs:label><vb:stepDrivenBy rdf:resource="urn:vbench:project:file-tests-test-create-note-py"/><vb:stepOf rdf:resource="urn:vbench:project:UC-N-001"/><vb:stepRealisedIn rdf:resource="urn:vbench:project:file-src-notes-create-py"/><vb:planned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</vb:planned></rdf:Description>
  <rdf:Description rdf:about="urn:vbench:project:TSK-N-001"><rdf:type rdf:resource="urn:vbench:method:Task"/><rdfs:label>TSK-N-001</rdfs:label><vb:buildsStep rdf:resource="urn:vbench:project:STP-N-003"/><vb:closesCriterion rdf:resource="urn:vbench:project:AC-N-002"/><vb:closesCriterion rdf:resource="urn:vbench:project:AC-N-003"/><vb:taskOf rdf:resource="urn:vbench:project:UC-N-001"/></rdf:Description>
  <rdf:Description rdf:about="urn:vbench:project:TSK-N-002"><rdf:type rdf:resource="urn:vbench:method:Task"/><rdfs:label>TSK-N-002</rdfs:label><vb:buildsStep rdf:resource="urn:vbench:project:STP-N-001"/><vb:buildsStep rdf:resource="urn:vbench:project:STP-N-002"/><vb:buildsStep rdf:resource="urn:vbench:project:STP-N-004"/><vb:buildsStep rdf:resource="urn:vbench:project:STP-N-005"/><vb:closesCriterion rdf:resource="urn:vbench:project:AC-N-001"/><vb:taskOf rdf:resource="urn:vbench:project:UC-N-001"/></rdf:Description>
  <rdf:Description rdf:about="urn:vbench:project:TSK-N-003"><rdf:type rdf:resource="urn:vbench:method:Task"/><rdfs:label>TSK-N-003</rdfs:label><vb:closesCriterion rdf:resource="urn:vbench:project:AC-N-004"/><vb:closesCriterion rdf:resource="urn:vbench:project:AC-N-005"/><vb:taskOf rdf:resource="urn:vbench:project:UC-N-002"/></rdf:Description>
  <rdf:Description rdf:about="urn:vbench:project:TSK-N-004"><rdf:type rdf:resource="urn:vbench:method:Task"/><rdfs:label>TSK-N-004</rdfs:label><vb:taskOf rdf:resource="urn:vbench:project:UC-N-003"/></rdf:Description>
  <rdf:Description rdf:about="urn:vbench:project:term-author"><rdf:type rdf:resource="urn:vbench:method:Term"/><rdfs:label>Author</rdfs:label><rdfs:comment>The one person who writes and reads their notes.</rdfs:comment><vb:termInContext rdf:resource="urn:vbench:project:ctx-notes"/><vb:confusedWith>User</vb:confusedWith></rdf:Description>
  <rdf:Description rdf:about="urn:vbench:project:term-body"><rdf:type rdf:resource="urn:vbench:method:Term"/><rdfs:label>Body</rdfs:label><rdfs:comment>The text of a note. It is required and at most 100 KB.</rdfs:comment><vb:termInContext rdf:resource="urn:vbench:project:ctx-notes"/><vb:confusedWith>Content</vb:confusedWith><vb:confusedWith>text</vb:confusedWith></rdf:Description>
  <rdf:Description rdf:about="urn:vbench:project:term-note"><rdf:type rdf:resource="urn:vbench:method:Term"/><rdfs:label>Note</rdfs:label><rdfs:comment>A piece of text the author keeps, with an optional title and a body.</rdfs:comment><vb:termInContext rdf:resource="urn:vbench:project:ctx-notes"/><vb:confusedWith>Document</vb:confusedWith><vb:confusedWith>memo</vb:confusedWith></rdf:Description>
